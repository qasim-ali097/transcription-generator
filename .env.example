# All optional - defaults shown.
PORT=3000
ENGINE=whisper                    # whisper | mock
WHISPER_MODEL=Xenova/whisper-base # e.g. Xenova/whisper-tiny.en (fastest), Xenova/whisper-small (more accurate)
WHISPER_DTYPE=q8                  # q8 | fp32 | fp16 | q4
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=14400
SYNC_MAX_DURATION_SEC=60          # longer files are processed as async jobs
CHUNK_MAX_SEC=28
CHUNK_MIN_SEC=18
SILENCE_RMS=0.01
JOB_CONCURRENCY=1
JOB_TTL_MIN=60
# FFMPEG_PATH= / FFPROBE_PATH=    # override the bundled/system ffmpeg
